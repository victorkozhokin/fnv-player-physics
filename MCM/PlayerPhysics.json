{
 "modName": "PlayerPhysics",
 "displayName": "$modDisplayName",
 "description": "$modDescription",
 "saveFile": "PlayerMovement/PlayerPhysics.ini",
 "minMCMVersion": 1.0,
 "minModVersion": 1.0,
 "requirements": [
  {
   "type": "dll",
   "file": "Player Physics",
   "version": 3
  }
 ],
 "submenus": {
  "1": {
   "listTitle": "$movement",
   "pageTitle": "$movement",
   "active": 1,
   "columns": 1,
   "enable": 1,
   "options": {
    "1": {
     "title": "$general",
     "type": 0,
     "enable": 1
    },
    "2": {
     "title": "$enabled",
     "type": 5,
     "enable": 1,
     "mouse": "$enabledMouse",
     "vars": [
      {
       "configINI": "Physics:bEnabled",
       "default": 1
      }
     ]
    },
    "3": {
     "title": "$preset",
     "type": 1,
     "enable": 1,
     "mouse": "$presetMouse",
     "vars": [
      {
       "configINI": "Physics:iPreset",
       "default": 1
      }
     ],
     "strings": [
      "$presetCustom",
      "$presetResponsive",
      "$presetGrounded",
      "$presetHeavy"
     ]
    },
    "4": {
     "title": "$ground",
     "type": 0,
     "enable": 1
    },
    "5": {
     "title": "$friction",
     "type": 2.5,
     "enable": 1,
     "mouse": "$frictionMouse",
     "vars": [
      {
       "configINI": "Physics:fFriction",
       "default": 5.0
      }
     ],
     "scale": {
      "valueDecimal": 2,
      "valueIncrement": 0.25,
      "valueMin": 0.0,
      "valueMax": 20.0
     },
     "state": {
      "configINI": "Physics:iPreset",
      "value": 0,
      "disable": 1
     }
    },
    "6": {
     "title": "$acceleration",
     "type": 2.5,
     "enable": 1,
     "mouse": "$accelerationMouse",
     "vars": [
      {
       "configINI": "Physics:fAcceleration",
       "default": 6.0
      }
     ],
     "scale": {
      "valueDecimal": 2,
      "valueIncrement": 0.25,
      "valueMin": 0.0,
      "valueMax": 30.0
     },
     "state": {
      "configINI": "Physics:iPreset",
      "value": 0,
      "disable": 1
     }
    },
    "7": {
     "title": "$stopSpeed",
     "type": 2.5,
     "enable": 1,
     "mouse": "$stopSpeedMouse",
     "vars": [
      {
       "configINI": "Physics:fStopSpeed",
       "default": 16.0
      }
     ],
     "scale": {
      "valueDecimal": 1,
      "valueIncrement": 1,
      "valueMin": 1.0,
      "valueMax": 200.0
     },
     "state": {
      "configINI": "Physics:iPreset",
      "value": 0,
      "disable": 1
     }
    },
    "8": {
     "title": "$air",
     "type": 0,
     "enable": 1
    },
    "9": {
     "title": "$airAcceleration",
     "type": 2.5,
     "enable": 1,
     "mouse": "$airAccelerationMouse",
     "vars": [
      {
       "configINI": "Physics:fAirAcceleration",
       "default": 1.0
      }
     ],
     "scale": {
      "valueDecimal": 2,
      "valueIncrement": 0.1,
      "valueMin": 0.0,
      "valueMax": 20.0
     },
     "state": {
      "configINI": "Physics:iPreset",
      "value": 0,
      "disable": 1
     }
    },
    "10": {
     "title": "$airSpeed",
     "type": 2.5,
     "enable": 1,
     "mouse": "$airSpeedMouse",
     "vars": [
      {
       "configINI": "Physics:fAirSpeed",
       "default": 1.0
      }
     ],
     "scale": {
      "valueDecimal": 2,
      "valueIncrement": 0.05,
      "valueMin": 0.0,
      "valueMax": 5.0
     },
     "state": {
      "configINI": "Physics:iPreset",
      "value": 0,
      "disable": 1
     }
    },
    "11": {
     "title": "$gravityMult",
     "type": 2.5,
     "enable": 1,
     "mouse": "$gravityMultMouse",
     "vars": [
      {
       "configINI": "Physics:fGravityMult",
       "default": 2.0
      }
     ],
     "scale": {
      "valueDecimal": 2,
      "valueIncrement": 0.05,
      "valueMin": 0.1,
      "valueMax": 5.0
     },
     "state": {
      "configINI": "Physics:iPreset",
      "value": 0,
      "disable": 1
     }
    },
    "12": {
     "title": "$landingPenalty",
     "type": 2.5,
     "enable": 1,
     "mouse": "$landingPenaltyMouse",
     "vars": [
      {
       "configINI": "Physics:fLandingPenaltyImpactSpeed50",
       "default": 100.0
      }
     ],
     "scale": {
      "valueDecimal": 0,
      "valueIncrement": 10,
      "valueMin": 10.0,
      "valueMax": 2000.0
     },
     "state": {
      "configINI": "Physics:iPreset",
      "value": 0,
      "disable": 1
     }
    }
   }
  },
  "2": {
   "listTitle": "$knockbackSlopes",
   "pageTitle": "$knockbackSlopes",
   "columns": 1,
   "enable": 1,
   "options": {
    "1": {
     "title": "$knockback",
     "type": 0,
     "enable": 1
    },
    "2": {
     "title": "$knockbackScale",
     "type": 2.5,
     "enable": 1,
     "mouse": "$knockbackScaleMouse",
     "vars": [
      {
       "configINI": "Physics:fKnockbackScale",
       "default": 10.0
      }
     ],
     "scale": {
      "valueDecimal": 1,
      "valueIncrement": 0.5,
      "valueMin": 0.0,
      "valueMax": 30.0
     },
     "state": {
      "configINI": "Physics:iPreset",
      "value": 0,
      "disable": 1
     }
    },
    "3": {
     "title": "$knockbackMaxSpeed",
     "type": 2.5,
     "enable": 1,
     "mouse": "$knockbackMaxSpeedMouse",
     "vars": [
      {
       "configINI": "Physics:fKnockbackMaxSpeed",
       "default": 900.0
      }
     ],
     "scale": {
      "valueDecimal": 0,
      "valueIncrement": 50,
      "valueMin": 0.0,
      "valueMax": 5000.0
     },
     "state": {
      "configINI": "Physics:iPreset",
      "value": 0,
      "disable": 1
     }
    },
    "4": {
     "title": "$slopes",
     "type": 0,
     "enable": 1
    },
    "5": {
     "title": "$scaleFrictionBySlope",
     "type": 5,
     "enable": 1,
     "mouse": "$scaleFrictionBySlopeMouse",
     "vars": [
      {
       "configINI": "Physics:bScaleFrictionBySlope",
       "default": 0
      }
     ]
    },
    "6": {
     "title": "$clipVelocityToSlope",
     "type": 5,
     "enable": 1,
     "mouse": "$clipVelocityToSlopeMouse",
     "vars": [
      {
       "configINI": "Physics:bClipVelocityToSlope",
       "default": 0
      }
     ]
    }
   }
  },
  "3": {
   "listTitle": "$patches",
   "pageTitle": "$patchesPage",
   "columns": 1,
   "enable": 1,
   "options": {
    "1": {
     "title": "$patchesNote",
     "type": 0,
     "enable": 1
    },
    "2": {
     "title": "$allowJumpWhileAiming",
     "type": 5,
     "enable": 1,
     "mouse": "$allowJumpWhileAimingMouse",
     "vars": [
      {
       "configINI": "Physics:bAllowJumpWhileAiming",
       "default": 1
      }
     ]
    },
    "3": {
     "title": "$keepGroundZVelocity",
     "type": 5,
     "enable": 1,
     "mouse": "$keepGroundZVelocityMouse",
     "vars": [
      {
       "configINI": "Physics:bKeepGroundZVelocity",
       "default": 1
      }
     ]
    },
    "4": {
     "title": "$bunnyhopGroundCollision",
     "type": 5,
     "enable": 1,
     "mouse": "$bunnyhopGroundCollisionMouse",
     "vars": [
      {
       "configINI": "Physics:bBunnyhopGroundCollision",
       "default": 1
      }
     ]
    }
   }
  }
 }
}
